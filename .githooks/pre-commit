#!/bin/sh
# Fast local gate for commits: type-check the frontend and lint the Rust
# workspace with the same flags as CI. Full tests live in `pnpm ci:local`.
set -eu

echo "Running pre-commit checks..."

echo "Checking TypeScript..."
if [ -x node_modules/.bin/tsc ]; then
  node_modules/.bin/tsc --noEmit
else
  pnpm typecheck
fi

echo "Checking Rust clippy..."
cargo clippy --workspace --all-targets --locked --no-default-features -- -D warnings

echo "All checks passed!"
