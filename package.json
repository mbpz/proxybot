{
  "name": "proxybot",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:tauri": "tauri build --features frida-runtime --config src-tauri/tauri.bundle.conf.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "resources:fetch": "bash scripts/fetch-bundle-resources.sh",
    "resources:check": "bash scripts/fetch-bundle-resources.sh --check",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs --set",
    "contract:generate": "cargo run -p proxybot --example export_desktop_contract --no-default-features",
    "contract:check": "cargo run -p proxybot --example export_desktop_contract --no-default-features -- --check",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --workspace --locked --no-default-features",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "lint:rust": "cargo clippy --workspace --all-targets --locked --no-default-features -- -D warnings",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:desktop:acceptance": "node scripts/test_desktop_acceptance.mjs",
    "ci:local": "pnpm version:check && cargo fmt --all -- --check && cargo test --workspace --locked --no-default-features && cargo clippy --workspace --all-targets --locked --no-default-features -- -D warnings && pnpm typecheck && pnpm test:ui && pnpm build",
    "prepare": "if [ -d .git ]; then git config core.hooksPath .githooks 2>/dev/null || true; fi"
  },
  "dependencies": {
    "@egjs/hammerjs": "^2.0.17",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "component-emitter": "^2.0.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "keycharm": "^0.4.0",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "uuid": "^14.0.1",
    "vis-data": "^8.0.4",
    "vis-network": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
