{
  "name": "proxybot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:tauri": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "resources:fetch": "bash scripts/fetch-bundle-resources.sh",
    "resources:check": "bash scripts/fetch-bundle-resources.sh --check",
    "typecheck": "tsc --noEmit",
    "test": "cargo test",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "lint:rust": "cargo clippy -- -D warnings",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ci:local": "cargo fmt --all -- --check && cargo test --workspace --locked && cargo clippy --workspace --locked -- -D warnings && pnpm typecheck && pnpm test:ui && pnpm build",
    "prepare": "if [ -d .git ]; then git config core.hooksPath .githooks 2>/dev/null || true; fi"
  },
  "dependencies": {
    "@egjs/hammerjs": "^2.0.17",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "component-emitter": "^2.0.0",
    "dompurify": "^3.4.2",
    "highlight.js": "^11.11.1",
    "keycharm": "^0.4.0",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "uuid": "^14.0.0",
    "vis-data": "^8.0.4",
    "vis-network": "^10.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
