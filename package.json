{
  "name": "proxybot",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:tauri": "tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:workflow-config": "node --test scripts/workflow-config.test.mjs",
    "parity:check": "node --test scripts/check_parity_matrix.test.mjs && node scripts/check_parity_matrix.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs --set",
    "contract:generate": "cargo run -p proxybot --example export_desktop_contract --no-default-features",
    "contract:check": "cargo run -p proxybot --example export_desktop_contract --no-default-features -- --check",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --workspace --locked --no-default-features",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "lint:rust": "cargo clippy --workspace --all-targets --locked --no-default-features -- -D warnings",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:desktop:acceptance": "node scripts/test_desktop_acceptance.mjs",
    "ci:local": "pnpm version:check && pnpm test:workflow-config && pnpm parity:check && cargo fmt --all -- --check && cargo test --workspace --locked --no-default-features && cargo clippy --workspace --all-targets --locked --no-default-features -- -D warnings && pnpm contract:check && pnpm typecheck && pnpm test:ui && pnpm build",
    "prepare": "if [ -d .git ]; then git config core.hooksPath .githooks 2>/dev/null || true; fi"
  },
  "dependencies": {
    "@egjs/hammerjs": "^2.0.17",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "component-emitter": "^2.0.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "keycharm": "^0.4.0",
    "lucide-react": "^1.61.0",
    "mermaid": "^11.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "uuid": "^14.0.3",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
