<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ProxyBot VPN Configuration Profile

  Install this profile on the iOS device to configure a VPN that routes
  all traffic through the ProxyBot Mac on your LAN.

  Before installing:
  1. Start ProxyBot on your Mac
  2. Get your Mac's LAN IP address
  3. Replace 10.0.0.2 below with your Mac's IP
  4. Start the VPN tunnel server: proxybot-tui vpn start --port 9999
  5. Install this profile via AirDrop, email, or a direct HTTPS URL

  The profile sets the Mac as both gateway and DNS server.
  All traffic is forwarded to the Mac where ProxyBot performs MITM decryption.
-->
<plist version="1.0">
<dict>
    <!-- Profile metadata -->
    <key>PayloadContent</key>
    <array>
        <dict>
            <!-- VPN payload -->
            <key>PayloadType</key>
            <string>com.apple.vpn.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.proxybot.app.vpn.config</string>
            <key>PayloadUUID</key>
            <string>B1C2D3E4-F5A6-7890-BCDE-F12345678901</string>
            <key>PayloadDisplayName</key>
            <string>ProxyBot VPN</string>
            <key>PayloadDescription</key>
            <string>Routes all device traffic through ProxyBot on your Mac for inspection and debugging.</string>

            <!-- Connection settings -->
            <key>UserDefinedName</key>
            <string>ProxyBot VPN</string>
            <key>VPNType</key>
            <string>VPN</string>
            <key>VPNSubType</key>
            <string>com.proxybot.app.vpn.packetTunnel</string>
            <key>ProviderBundleIdentifier</key>
            <string>com.proxybot.app.vpn.packetTunnel</string>

            <!-- Always-on VPN -->
            <key>OnDemandEnabled</key>
            <integer>1</integer>
            <key>OnDemandRules</key>
            <array>
                <dict>
                    <!-- Connect VPN on any network -->
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>WiFi</string>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>Cellular</string>
                </dict>
                <dict>
                    <!-- Disconnect when on same subnet as Mac (local LAN) to avoid routing loop -->
                    <key>Action</key>
                    <string>Disconnect</string>
                    <key>SSIDMatch</key>
                    <array>
                        <string>YourWiFiSSID</string>
                    </array>
                </dict>
            </array>

            <!-- Pass the Mac IP to the tunnel provider -->
            <key>VendorConfig</key>
            <dict>
                <key>macHost</key>
                <string>10.0.0.2</string>
            </dict>
        </dict>
    </array>

    <!-- Root-level profile metadata -->
    <key>PayloadDisplayName</key>
    <string>ProxyBot VPN Profile</string>
    <key>PayloadIdentifier</key>
    <string>com.proxybot.app.vpn.profile</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadUUID</key>
    <string>A1B2C3D4-E5F6-7890-ABCD-E12345678902</string>
    <key>PayloadDescription</key>
    <string>Installs the ProxyBot VPN configuration for traffic inspection.</string>
    <key>PayloadOrganization</key>
    <string>ProxyBot</string>
</dict>
</plist>
